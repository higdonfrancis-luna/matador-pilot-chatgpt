# These two values identify the existing Sanity project; they are not secrets.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# fixture is a local review copy. Set sanity after importing content.
CONTENT_MODE=fixture
# Viewer-only token for private content and draft previews. Server-only.
SANITY_API_READ_TOKEN=
# Editor token for the one-time import. Never commit or expose to the browser.
SANITY_API_WRITE_TOKEN=
# Your deployed frontend origin (or http://localhost:4173 for local development).
NEXT_PUBLIC_SITE_URL=http://localhost:4173
